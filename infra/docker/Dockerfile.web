# Multi-stage Dockerfile for Next.js 15 Front-End
FROM node:20-alpine AS base
WORKDIR /app

FROM base AS dependencies
COPY package.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/vidren-dsl/package.json ./packages/vidren-dsl/
COPY packages/vidren-runtime/package.json ./packages/vidren-runtime/
COPY packages/agent-core/package.json ./packages/agent-core/
RUN npm install

FROM base AS builder
COPY . .
COPY --from=dependencies /app/node_modules ./node_modules
RUN npm run build --workspace=apps/web

FROM base AS runner
ENV NODE_ENV=production
COPY --from=builder /app/apps/web/public ./apps/web/public
COPY --from=builder /app/apps/web/.next ./apps/web/.next
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/web/package.json ./apps/web/package.json

EXPOSE 3000
CMD ["npm", "start", "--workspace=apps/web"]
