{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@vidren/dsl": ["packages/vidren-dsl/src/index.ts"],
      "@vidren/runtime": ["packages/vidren-runtime/src/index.ts"],
      "@vidren/database": ["packages/database/src/index.ts"]
    }
  },
  "exclude": ["node_modules"]
}
